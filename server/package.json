{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "db:setup": "npm run db:push && npm run seed",
    "dev": "tsx watch src/index.ts",
    "smoke:auth": "tsx src/scripts/auth-smoke.ts",
    "test:integration": "tsx src/scripts/integration-test.ts",
    "seed": "tsx src/db/seed.ts",
    "db:push": "npx drizzle-kit push",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "test": "node --import ./node_modules/tsx/dist/loader.mjs --test tests/unit/*.test.ts",
    "test:coverage": "node --import ./node_modules/tsx/dist/loader.mjs --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=75 --test-coverage-functions=85 tests/unit/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "BSD-3-Clause",
  "dependencies": {
    "better-auth": "1.4.18",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.1",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "pg": "8.18.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.31",
    "@types/pg": "8.16.0",
    "drizzle-kit": "0.31.9",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
